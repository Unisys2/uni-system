### University Microservices - REST + GraphQL test requests
### Open in VS Code with the "REST Client" extension and click "Send Request".
### Run the requests top to bottom; copy ids from responses into the variables below.

@gateway = http://localhost:3000

# Filled in manually from earlier responses:
@token = PASTE_TOKEN_HERE
@studentId = PASTE_STUDENT_ID_HERE
@courseId = PASTE_COURSE_ID_HERE
@enrollmentId = PASTE_ENROLLMENT_ID_HERE
@invoiceId = PASTE_INVOICE_ID_HERE

############################################################
# AUTH
############################################################

### Register a student (also triggers Kafka user.registered -> Student profile)
POST {{gateway}}/api/auth/register
Content-Type: application/json

{
  "name": "Yahia Mabrouk",
  "email": "yahia@university.edu",
  "password": "secret123",
  "role": "student"
}

### Register an admin (used to create courses)
POST {{gateway}}/api/auth/register
Content-Type: application/json

{
  "name": "Dr. Gontara",
  "email": "admin@university.edu",
  "password": "admin123",
  "role": "admin"
}

### Login -> copy "token" into @token above
POST {{gateway}}/api/auth/login
Content-Type: application/json

{
  "email": "yahia@university.edu",
  "password": "secret123"
}

### Profile (protected)
GET {{gateway}}/api/auth/profile
Authorization: Bearer {{token}}

############################################################
# STUDENTS
############################################################

### List students (profile auto-created by Kafka) -> copy an id into @studentId
GET {{gateway}}/api/students

### Get one student
GET {{gateway}}/api/students/{{studentId}}

### Update student profile (protected)
PUT {{gateway}}/api/students/{{studentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "department": "Computer Science",
  "level": "L3",
  "status": "active"
}

############################################################
# COURSES & ENROLLMENT
############################################################

### Create a course (protected) -> copy "id" into @courseId
POST {{gateway}}/api/courses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Microservices Architecture",
  "code": "CS301",
  "capacity": 30,
  "semester": "2025-S1",
  "tuition": 500
}

### List courses
GET {{gateway}}/api/courses

### Enroll a student (protected) -> triggers Kafka student.enrolled
### -> copy "id" into @enrollmentId
POST {{gateway}}/api/enrollments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "student_id": "{{studentId}}",
  "course_id": "{{courseId}}"
}

### Drop an enrollment (protected)
DELETE {{gateway}}/api/enrollments/{{enrollmentId}}
Authorization: Bearer {{token}}

############################################################
# PAYMENTS
############################################################

### List payments for a student (invoice auto-created by Kafka)
### -> copy an invoice "id" into @invoiceId
GET {{gateway}}/api/payments/student/{{studentId}}

### Pay an invoice (protected)
POST {{gateway}}/api/payments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "invoice_id": "{{invoiceId}}"
}

############################################################
# ATTENDANCE
############################################################

### Check in with a QR code (protected) -> triggers Kafka attendance.checked_in
POST {{gateway}}/api/attendance/check-in
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "student_id": "{{studentId}}",
  "course_id": "{{courseId}}",
  "qr_code": "SESSION-QR-2025"
}

### Attendance report for a student
GET {{gateway}}/api/attendance/student/{{studentId}}

### Attendance for a course
GET {{gateway}}/api/attendance/course/{{courseId}}

############################################################
# GRAPHQL  (flexible cross-service query)
############################################################

### One student with enrollments + payments + attendance, only selected fields
POST {{gateway}}/graphql
Content-Type: application/json

{
  "query": "query($id: ID!) { student(id: $id) { name level enrollments { status course { title code } } payments { amount status } attendance { totalCheckIns attendancePercentage } } }",
  "variables": { "id": "{{studentId}}" }
}

### List all courses (GraphQL)
POST {{gateway}}/graphql
Content-Type: application/json

{
  "query": "{ courses { id title code capacity enrolled tuition } }"
}

### Enroll via GraphQL mutation
POST {{gateway}}/graphql
Content-Type: application/json

{
  "query": "mutation($s: ID!, $c: ID!) { enroll(studentId: $s, courseId: $c) { id status } }",
  "variables": { "s": "{{studentId}}", "c": "{{courseId}}" }
}
