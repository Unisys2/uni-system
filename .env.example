# Copy to .env for local runs. In Docker these are set by docker-compose.yml.

# Kafka broker address
KAFKA_BROKER=localhost:9092

# gRPC service hosts (use service names instead of localhost when running in Docker)
AUTH_HOST=localhost
STUDENT_HOST=localhost
COURSE_HOST=localhost
PAYMENT_HOST=localhost
ATTENDANCE_HOST=localhost

# API Gateway HTTP port
GATEWAY_PORT=3000

# JWT secret used by the Auth service
JWT_SECRET=university_secret_change_me
